# Staff key for the manual review queue at /admin.
# The review queue stays closed until this is set — it is never left unguarded.
DIW_ADMIN_KEY=

# Image-analysis mode for the vision-dependent checks (see lib/analysis.ts).
#   manual (default) — no auto-decisions; every submission reaches a DiW reviewer
#   demo             — auto-passes image checks so the flow can be walked end to end
DIW_ANALYZER=manual

# SMTP, for the "Send email" button on a Legacy case (see lib/email.ts). Staff write and send
# each email themselves — nothing sends automatically. Leave these blank to disable the button;
# it stays disabled rather than failing partway through a send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender. Falls back to SMTP_USER if left blank.
SMTP_FROM="DiW Authentication <noreply@example.com>"
