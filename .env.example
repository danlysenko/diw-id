# Staff key for the manual review queue at /admin.
# The review queue stays closed until this is set — it is never left unguarded.
DIW_ADMIN_KEY=

# Image-analysis mode for the vision-dependent checks (see lib/analysis.ts).
#   manual (default) — no auto-decisions; every submission reaches a DiW reviewer
#   demo             — auto-passes image checks so the flow can be walked end to end
DIW_ANALYZER=manual
